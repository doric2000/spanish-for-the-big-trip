# Copy to api/.env (ignored by Git) and fill in locally. Never paste the secret key in chat or docs.
# Supabase Dashboard -> Project Settings -> API Keys.
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SECRET_KEY=
# Development only: serve the newest draft revision (approved-decisions.json#stage05_draft_units_in_development).
ALLOW_DRAFT_UNITS=true
PORT=3000
