{
  "expo": {
    "name": "ספרדית לטיול הגדול",
    "slug": "spanish-for-the-big-trip",
    "scheme": "spanishforthebigtrip",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/brand/app-icon-d1.png",
    "userInterfaceStyle": "light",
    "ios": {
      "bundleIdentifier": "com.doric2000.spanishforthebigtrip",
      "usesAppleSignIn": true,
      "supportsTablet": false,
      "config": {
        "usesNonExemptEncryption": false
      },
      "infoPlist": {
        "CFBundleDevelopmentRegion": "he",
        "CFBundleLocalizations": [
          "he"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "eb8d7f0d-b9ba-4e95-9660-836a55a4a43c"
      }
    },
    "owner": "doric2000",
    "plugins": [
      "expo-router",
      [
        "expo-audio",
        {
          "microphonePermission": "האפליקציה זקוקה לגישה למיקרופון כדי להקליט את התרגול שלך ולהשמיע אותו עבורך.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      "expo-secure-store",
      "expo-asset",
      "expo-web-browser",
      "expo-font",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.955830111466-1d2i90vmc2mfolenqeaieg7rqa5u6brs"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#21655B",
          "image": "./assets/brand/splash-mark-d1.png",
          "imageWidth": 320,
          "resizeMode": "contain"
        }
      ],
      "expo-image"
    ]
  }
}
